# Two or more provider keys; key ids are assigned as key_1, key_2, ... in this order.
LLM_API_KEYS=replace-with-provider-key-1,replace-with-provider-key-2
LLM_MODEL=gemini/gemini-3.5-flash-lite
DEFAULT_SYSTEM_PROMPT=You are Lyftr AI, a thoughtful and concise assistant. Use the conversation history to answer follow-up questions. If you are uncertain, say so clearly.

# Local Docker uses ./app.db; Compose and Render override this to sqlite:////data/app.db.
DATABASE_URL=sqlite:///./app.db
# Use the exact public frontend origin with no trailing slash in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_FAILURE_SIMULATION=true

# LiteLLM's built-in in-memory cache.
CACHE_TTL_SECONDS=3600

# Provider request controls.
REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=4096
# Optional. Omitted by default because Gemini 3 models reject temperature.
# TEMPERATURE=1

# Vite embeds this value in the frontend at build time.
VITE_API_BASE_URL=http://localhost:8000

# Optional host port overrides for docker-compose.yml.
BACKEND_PORT=8000
FRONTEND_PORT=3000
